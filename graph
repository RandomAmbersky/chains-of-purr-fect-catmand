import { useCallback, useEffect, useRef, useState } from 'react';
import type { Node, Edge, NodeChange, EdgeChange, Connection } from '@xyflow/react';
import { applyNodeChanges, applyEdgeChanges } from '@xyflow/react';
import type { GameEngine } from '../core/GameEngine';
import type { GameSnapshot } from '../core/types';
import { ROOM_KIND_LABELS } from '../core/types';

export type RoomNodeData = {
  kind: string;
  name: string;
  level: number;
  queue: number;
  maxQueue: number;
  speed: number;
  producing: boolean;
  currency: number;
  upgradeCost: number;
  canUpgrade: boolean;
  onUpgrade: (roomId: string) => void;
  onAssign: (roomId: string) => void;
};

export type CatNodeData = {
  name: string;
  role: string;
  emoji: string;
  state: string;
  energy: number;
  assignedRoom: string | null;
  onAssign: (catId: string) => void;
};

export type ResourceEdgeData = {
  kind: string;
  t: number;
};

export function useGameSync(engine: GameEngine) {
  const [snapshot, setSnapshot] = useState<GameSnapshot>(() => engine.getSnapshot());
  const engineRef = useRef(engine);

  useEffect(() => {
    const unsub = engine.subscribe((s) => setSnapshot(s));
    return unsub;
  }, [engine]);

  // Конвертация snapshot → nodes/edges React Flow
  const nodes: Node[] = snapshot.rooms.map((room) => ({
    id: room.id,
    type: 'room',
    position: room.position,
    data: {
      kind: room.kind,
      name: room.name,
      level: room.level,
      queue: room.queue,
      maxQueue: room.maxQueue,
      speed: room.baseSpeed * Math.pow(1.25, room.level - 1),
      producing: room.producing,
      currency: snapshot.stats.currency,
      upgradeCost: Math.round(10 * Math.pow(2, room.level - 1)),
      canUpgrade: snapshot.stats.currency >= Math.round(10 * Math.pow(2, room.level - 1)),
      onUpgrade: (roomId: string) => engine.upgradeNode(roomId),
      onAssign: (roomId: string) => {},
    } as RoomNodeData,
  }));

  // Коты как отдельные узлы (позиция интерполируется в UI)
  const catNodes: Node[] = snapshot.cats.map((cat) => ({
    id: cat.id,
    type: 'cat',
    position: { x: 0, y: 0 }, // позиция будет вычислена в CatNode
    data: {
      name: cat.name,
      role: cat.role,
      emoji: cat.emoji,
      state: cat.state,
      energy: cat.energy,
      assignedRoom: cat.assignedRoom,
      onAssign: (catId: string) => {},
    } as CatNodeData,
  }));

  const edges: Edge[] = snapshot.edges.map((edge) => ({
    id: edge.id,
    source: edge.from,
    target: edge.to,
    type: 'resource',
    data: {
      kind: 'container',
      t: 0,
    } as ResourceEdgeData,
  }));

  return { nodes: [...nodes, ...catNodes], edges, snapshot };
}